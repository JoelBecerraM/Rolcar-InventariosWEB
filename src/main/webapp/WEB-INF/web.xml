<?xml version="1.0" encoding="UTF-8"?>
<web-app version="2.4" xmlns="http://java.sun.com/xml/ns/j2ee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd">
    <servlet>
        <servlet-name>ModelViewController</servlet-name>
        <servlet-class>com.atcloud.servlets.ModelViewController</servlet-class>
        <init-param>
            <param-name>mvcConfigFile</param-name>
            <param-value>/WEB-INF/mvc-controller.xml</param-value>
        </init-param>
        <init-param>
            <param-name>dataSourceName</param-name>
            <param-value>jdbc/inventarios</param-value>
        </init-param>
        <init-param>
            <param-name>sessionFailPage</param-name>
            <param-value>/inventarios/index.jsp</param-value>
        </init-param>
    </servlet>
    <servlet>
        <servlet-name>ResponseController</servlet-name>
        <servlet-class>com.atcloud.servlets.ResponseController</servlet-class>
        <init-param>
            <param-name>dataSourceName</param-name>
            <param-value>jdbc/inventarios</param-value>
        </init-param>
        <init-param>
            <param-name>responseConfigFile</param-name>
            <param-value>/WEB-INF/response-controller.xml</param-value>
        </init-param>
    </servlet>
    <servlet>
        <servlet-name>ExportadorExcel</servlet-name>
        <servlet-class>com.atcloud.servlets.ExportadorExcel</servlet-class>
        <init-param>
            <param-name>dataSourceName</param-name>
            <param-value>jdbc/inventarios</param-value>
        </init-param>
        <init-param>
            <param-name>exportadorImp</param-name>
            <param-value>mx.com.rolcar.inventarios.exportacion.ExportadorExcelImp</param-value>
        </init-param>
    </servlet>
    <servlet>
        <servlet-name>Log4JInitServlet</servlet-name>
        <servlet-class>com.atcloud.servlets.Log4JInitServlet</servlet-class>
        <init-param>
            <param-name>log4j-properties-location</param-name>
            <param-value>/WEB-INF/log4j.properties</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>Upload</servlet-name>
        <servlet-class>com.atcloud.servlets.UploadServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Descarga</servlet-name>
        <servlet-class>com.atcloud.servlets.DescargaServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CargaInventario</servlet-name>
        <servlet-class>mx.com.rolcar.inventarios.servlets.CargaInventarioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ModelViewController</servlet-name>
        <url-pattern>/MVC</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ResponseController</servlet-name>
        <url-pattern>/ResponseController</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ExportadorExcel</servlet-name>
        <url-pattern>/ExportadorExcel</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Upload</servlet-name>
        <url-pattern>/Upload</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Descarga</servlet-name>
        <url-pattern>/Descarga</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CargaInventario</servlet-name>
        <url-pattern>/CargaInventario</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>15</session-timeout>
    </session-config>
    <resource-ref>
        <res-ref-name>jdbc/inventarios</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
        <res-sharing-scope>Shareable</res-sharing-scope>
    </resource-ref>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
